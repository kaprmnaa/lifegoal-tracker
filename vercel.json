{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/habit", "destination": "/habit/index.html" },
    { "source": "/habit/(.*)", "destination": "/habit/index.html" },
    { "source": "/finance", "destination": "/finance/index.html" },
    { "source": "/finance/(.*)", "destination": "/finance/index.html" },
    { "source": "/tugas", "destination": "/tugas/index.html" },
    { "source": "/tugas/(.*)", "destination": "/tugas/index.html" }
  ]
}
