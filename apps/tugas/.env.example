# Salin file ini menjadi ".env" lalu isi dengan kredensial project Supabase kamu.
# Kalau file .env tidak diisi / tidak ada, aplikasi otomatis pakai penyimpanan
# lokal (localStorage) di browser — tetap bisa dipakai tanpa Supabase.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
